# Copy to .env.local and fill in. NEVER commit .env.local. This file holds names only.

# Supabase (server-side only; the service-role key bypasses RLS, so never expose it to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (billed API key, not a free-tier key)
GEMINI_API_KEY=
GEMINI_MODEL=

# Resend (handoff emails)
RESEND_API_KEY=
EMAIL_FROM=
NIKHIL_EMAIL=

# Vaani webhook signature secret (set the same value in the Vaani agent's webhook settings)
VAANI_WEBHOOK_SECRET=

# Public base URL used for links inside emails, e.g. https://your-app.vercel.app
APP_BASE_URL=

# Shared secret that scheduled jobs send to /api/cron/* (Phase 3)
CRON_SECRET=

# Secret that signs the designers' claim links (any long random string)
CLAIM_LINK_SECRET=

# Dashboard sign-in (Phase 4)
DASHBOARD_PASSWORD=

# HubSpot private app access token (scopes listed in README) and the numeric portal (hub) id used for deep links
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
